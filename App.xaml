<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="FlagsRally.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:FlagsRally.Converters"
    xmlns:local="clr-namespace:FlagsRally">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  Converters used on more than one page  -->
            <converters:FontFamilyConverter x:Key="FontFamilyConverter" />
            <converters:BoardFontSizeConverter x:Key="BoardFontSize" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
