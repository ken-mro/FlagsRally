<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FlagsRally.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FlagsRally"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:views="clr-namespace:FlagsRally.Views"
    Title="FlagsRally"
    Shell.FlyoutBehavior="Disabled">

    <!--  Tabs by purpose: look back (Passport), record (Map), collect (Collections), configure (Settings)  -->
    <TabBar>
        <ShellContent
            Title="{x:Static strings:AppResources.TabPassport}"
            ContentTemplate="{DataTemplate views:MainPage}"
            Icon="flag.png"
            Route="Passport" />
        <ShellContent
            Title="{x:Static strings:AppResources.TabMap}"
            ContentTemplate="{DataTemplate views:LocationPage}"
            Icon="location.png"
            Route="Map" />
        <ShellContent
            Title="{x:Static strings:AppResources.TabCollections}"
            ContentTemplate="{DataTemplate views:CollectionsPage}"
            Icon="board.png"
            Route="Collections" />
        <ShellContent
            Title="{x:Static strings:AppResources.Settings}"
            ContentTemplate="{DataTemplate views:SettingPage}"
            Icon="settings.png"
            Route="Settings" />
    </TabBar>

</Shell>
