<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.CollectionsPage"
    x:Name="page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    xmlns:views="clr-namespace:FlagsRally.Views"
    x:DataType="viewmodels:CollectionsPageViewModel"
    Style="{StaticResource PaperPage}">
    <!--  One template per kind of card, holding only the views that kind shows: building a cell is
          what makes the first scroll stutter, so a card does not carry hidden views for the other kinds.  -->
    <ContentPage.Resources>
        <Style x:Key="CardFrame" TargetType="Border">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BackgroundColor" Value="{StaticResource PaperCard}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        </Style>
        <Style x:Key="CardTitle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="CardProgressText" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        </Style>

        <DataTemplate x:Key="RemoteImageCard" x:DataType="viewmodels:CollectionCard">
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Border
                        Padding="0"
                        HeightRequest="96"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="0">
                        <Image Aspect="AspectFill">
                            <Image.Source>
                                <UriImageSource
                                    CacheValidity="30"
                                    CachingEnabled="True"
                                    Uri="{Binding RemoteImageUrl}" />
                            </Image.Source>
                        </Image>
                    </Border>
                    <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Stamp}" />
                    <Label Style="{StaticResource CardProgressText}" Text="{Binding ProgressText}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!--  Bundled emblems are drawn whole on the card rather than cropped  -->
        <DataTemplate x:Key="LocalImageCard" x:DataType="viewmodels:CollectionCard">
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="96"
                        Source="{Binding LocalImageFile}" />
                    <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Stamp}" />
                    <Label Style="{StaticResource CardProgressText}" Text="{Binding ProgressText}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BadgeCard" x:DataType="viewmodels:CollectionCard">
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Border
                        BackgroundColor="{StaticResource Navy}"
                        HeightRequest="96"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="0">
                        <controls:StampLabel
                            FontSize="44"
                            HorizontalOptions="Center"
                            Text="{Binding Badge}"
                            TextColor="{StaticResource PaperCard}"
                            VerticalOptions="Center" />
                    </Border>
                    <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Stamp}" />
                    <Label Style="{StaticResource CardProgressText}" Text="{Binding ProgressText}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AddCard" x:DataType="viewmodels:CollectionCard">
            <Border
                Margin="4"
                Padding="8"
                BackgroundColor="Transparent"
                Stroke="{StaticResource InkMuted}"
                StrokeDashArray="4,3"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="6">
                    <Label
                        FontSize="40"
                        HeightRequest="96"
                        HorizontalTextAlignment="Center"
                        Text="+"
                        TextColor="{StaticResource Navy}"
                        VerticalTextAlignment="Center" />
                    <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <views:CollectionCardTemplateSelector
            x:Key="CardTemplates"
            AddCard="{StaticResource AddCard}"
            BadgeCard="{StaticResource BadgeCard}"
            LocalImageCard="{StaticResource LocalImageCard}"
            RemoteImageCard="{StaticResource RemoteImageCard}" />
    </ContentPage.Resources>
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{x:Static strings:AppResources.TabCollections}" />
    </Shell.TitleView>
    <!--  iOS's tab bar floats over the bottom of the list, and a grouped list shows no footer there:
          the margin keeps the last row of cards above the tab bar.  -->
    <CollectionView
        Margin="{OnPlatform iOS='8,0,8,72', Default='8,0'}"
        x:Name="Cards"
        IsGrouped="True"
        ItemsSource="{Binding Sections}"
        ItemTemplate="{StaticResource CardTemplates}"
        SelectionChanged="OnCardSelected"
        SelectionMode="Single">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="2" />
        </CollectionView.ItemsLayout>
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="viewmodels:CollectionSection">
                <!--  Tapping a collapsible heading folds its cards away  -->
                <Grid
                    Padding="4,16,4,4"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="6">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewModel.ToggleSectionCommand, Source={x:Reference page}, x:DataType=views:CollectionsPage}" CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                    <Label
                        FontSize="20"
                        IsVisible="{Binding IsCollapsible}"
                        Text="{Binding Chevron}"
                        TextColor="{StaticResource Navy}"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <controls:StampLabel
                        Grid.Column="1"
                        Style="{StaticResource StampHeading}"
                        Text="{Binding Title}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        FontSize="13"
                        Text="{Binding Summary}"
                        TextColor="{StaticResource InkMuted}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="3"
                        Padding="8,0"
                        BackgroundColor="Transparent"
                        Command="{Binding ViewModel.EditBoardsCommand, Source={x:Reference page}, x:DataType=views:CollectionsPage}"
                        HorizontalOptions="End"
                        IsVisible="{Binding IsEditable}"
                        Text="{x:Static strings:AppResources.Edit}"
                        TextColor="{StaticResource Navy}" />
                </Grid>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>
    </CollectionView>
</ContentPage>
