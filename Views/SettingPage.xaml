<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.SettingPage"
    x:Name="settingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:SettingPageViewModel"
    Style="{StaticResource PaperPage}">
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{x:Static strings:AppResources.Settings}" />
    </Shell.TitleView>
    <ContentPage.Resources>
        <!--  Grouped list: a heading, then a card of rows separated by thin lines  -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource PaperCard}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="ColumnSpacing" Value="10" />
        </Style>
        <!--  A small heading inside a section, above a card  -->
        <Style x:Key="SettingsSubheading" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
            <Setter Property="Margin" Value="4,2,4,-4" />
        </Style>
        <Style x:Key="SettingsCheck" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Text" Value="✓" />
            <Setter Property="TextColor" Value="{StaticResource Navy}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="RowDivider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="Color" Value="{StaticResource PaperEdge}" />
        </Style>
        <Style x:Key="Chevron" TargetType="Label">
            <Setter Property="Text" Value="›" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">

            <!--  Country of residence  -->
            <controls:StampLabel Style="{StaticResource StampHeading}" Text="{x:Static strings:AppResources.CountryOfResidence}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="36"
                        Source="{Binding ImageSourceString}"
                        VerticalOptions="Center">
                        <Image.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean">
                                <On Platform="iOS">False</On>
                                <On Platform="MacCatalyst">False</On>
                                <On Platform="WinUI">True</On>
                                <On Platform="Android">False</On>
                            </OnPlatform>
                        </Image.IsVisible>
                    </Image>
                    <Label
                        FontSize="32"
                        Text="{Binding SelectedCountry.CountryFlag}"
                        VerticalOptions="Center">
                        <Label.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean">
                                <On Platform="iOS">True</On>
                                <On Platform="MacCatalyst">True</On>
                                <On Platform="Android">True</On>
                                <On Platform="WinUI">False</On>
                            </OnPlatform>
                        </Label.IsVisible>
                    </Label>
                    <Picker
                        Title="{x:Static strings:AppResources.CountryOfResidence}"
                        Grid.Column="1"
                        FontSize="16"
                        ItemDisplayBinding="{Binding CountryName}"
                        ItemsSource="{Binding CountryList}"
                        SelectedItem="{Binding SelectedCountry}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  Map pin style  -->
            <controls:StampLabel Style="{StaticResource StampHeading}" Text="{x:Static strings:AppResources.MapPins}" />
            <Border Style="{StaticResource SettingsCard}">
              <VerticalStackLayout>
                <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="Auto,*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetPinStyleCommand}" CommandParameter="Classic" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="2">
                        <Image
                            HeightRequest="40"
                            IsVisible="{Binding HasCustomBoards}"
                            Source="classic_pin.png"
                            WidthRequest="29" />
                        <Image
                            HeightRequest="40"
                            IsVisible="{Binding HasCustomBoards}"
                            Source="classic_pin_arrived.png"
                            WidthRequest="29" />
                        <Image
                            HeightRequest="40"
                            Source="classic_default_pin.png"
                            WidthRequest="29" />
                        <Image
                            HeightRequest="40"
                            Source="classic_selected_location_pin.png"
                            WidthRequest="29" />
                    </HorizontalStackLayout>
                    <Label
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        FontSize="16"
                        Text="{x:Static strings:AppResources.PinStyleClassic}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="20"
                        IsVisible="{Binding UsesClassicPins}"
                        Text="✓"
                        TextColor="{StaticResource Navy}"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="Auto,*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetPinStyleCommand}" CommandParameter="Drop" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="2">
                        <Image
                            HeightRequest="40"
                            IsVisible="{Binding HasCustomBoards}"
                            Source="pin.png"
                            WidthRequest="29" />
                        <Image
                            HeightRequest="40"
                            IsVisible="{Binding HasCustomBoards}"
                            Source="pin_arrived.png"
                            WidthRequest="29" />
                        <Image
                            HeightRequest="40"
                            Source="default_pin.png"
                            WidthRequest="29" />
                        <Image
                            HeightRequest="40"
                            Source="selected_location_pin.png"
                            WidthRequest="29" />
                    </HorizontalStackLayout>
                    <Label
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        FontSize="16"
                        Text="{x:Static strings:AppResources.PinStyleDrop}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="20"
                        IsVisible="{Binding UsesDropPins}"
                        Text="✓"
                        TextColor="{StaticResource Navy}"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="Auto,*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetPinStyleCommand}" CommandParameter="Critter" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="2">
                        <Image
                            HeightRequest="40"
                            IsVisible="{Binding HasCustomBoards}"
                            Source="critter_pin.png"
                            WidthRequest="29" />
                        <Image
                            HeightRequest="40"
                            IsVisible="{Binding HasCustomBoards}"
                            Source="critter_pin_arrived.png"
                            WidthRequest="29" />
                        <Image
                            HeightRequest="40"
                            Source="critter_default_pin.png"
                            WidthRequest="29" />
                        <Image
                            HeightRequest="40"
                            Source="critter_selected_location_pin.png"
                            WidthRequest="29" />
                    </HorizontalStackLayout>
                    <Label
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        FontSize="16"
                        Text="{x:Static strings:AppResources.PinStyleCritter}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="20"
                        IsVisible="{Binding UsesCritterPins}"
                        Text="✓"
                        TextColor="{StaticResource Navy}"
                        VerticalOptions="Center" />
                </Grid>
              </VerticalStackLayout>
            </Border>

            <!--  Passport stamps: the design (a mix, one per country, or the same one for every stamp,
                  picked in a dropdown) and, apart from it, whether they lean as if pressed by hand  -->
            <controls:StampLabel Style="{StaticResource StampHeading}" Text="{x:Static strings:AppResources.PassportStamps}" />
            <Label Style="{StaticResource SettingsSubheading}" Text="{x:Static strings:AppResources.StampDesign}" />
            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" Style="{StaticResource SettingsRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetStampModeCommand}" CommandParameter="Mixed" />
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout Spacing="3" VerticalOptions="Center" WidthRequest="114">
                            <controls:StampFrame HeightRequest="28" IsSmall="True" Pattern="Sunrise" WidthRequest="36" />
                            <controls:StampFrame HeightRequest="28" IsSmall="True" Pattern="Airmail" WidthRequest="36" />
                            <controls:StampFrame HeightRequest="28" IsSmall="True" Pattern="CompassHexagon" WidthRequest="36" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label FontSize="16" Text="{x:Static strings:AppResources.StampStyleMixed}" />
                            <Label FontSize="12" Text="{x:Static strings:AppResources.StampStyleMixedHint}" TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" IsVisible="{Binding IsStampMixed}" Style="{StaticResource SettingsCheck}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDivider}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Style="{StaticResource SettingsRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetStampModeCommand}" CommandParameter="ByCountry" />
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout Spacing="3" VerticalOptions="Center" WidthRequest="114">
                            <controls:StampFrame HeightRequest="28" IsSmall="True" Pattern="Ticket" WidthRequest="36" />
                            <controls:StampFrame HeightRequest="28" IsSmall="True" Pattern="Ticket" WidthRequest="36" />
                            <controls:StampFrame HeightRequest="28" IsSmall="True" Pattern="StarSeal" WidthRequest="36" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label FontSize="16" Text="{x:Static strings:AppResources.StampStyleByCountry}" />
                            <Label FontSize="12" Text="{x:Static strings:AppResources.StampStyleByCountryHint}" TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" IsVisible="{Binding IsStampByCountry}" Style="{StaticResource SettingsCheck}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDivider}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Style="{StaticResource SettingsRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetStampModeCommand}" CommandParameter="Same" />
                        </Grid.GestureRecognizers>
                        <!--  The chosen design, drawn  -->
                        <controls:StampFrame
                            HeightRequest="28"
                            HorizontalOptions="Start"
                            IsSmall="True"
                            Pattern="{Binding SelectedStampDesign.Pattern}"
                            VerticalOptions="Center"
                            WidthRequest="36" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label FontSize="16" Text="{x:Static strings:AppResources.StampStyleSame}" />
                            <Label FontSize="12" Text="{x:Static strings:AppResources.StampStyleSameHint}" TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" IsVisible="{Binding IsStampSame}" Style="{StaticResource SettingsCheck}" />
                    </Grid>
                    <!--  The dropdown: a button with the chosen design, and the list of designs opening below it.
                          Not a Picker, which is a dialog on Android and a wheel on iOS.  -->
                    <VerticalStackLayout Margin="60,0,14,12">
                        <Border
                            Padding="12,8"
                            BackgroundColor="{StaticResource Paper}"
                            Stroke="{StaticResource PaperEdge}"
                            StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleStampDesignListCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label
                                    FontSize="16"
                                    Text="{Binding SelectedStampDesign.Name}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="▾"
                                    TextColor="{StaticResource InkMuted}"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsStampDesignListOpen}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="Text" Value="▴" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                        <Border
                            Margin="0,4,0,0"
                            Padding="0,4"
                            BackgroundColor="{StaticResource Paper}"
                            IsVisible="{Binding IsStampDesignListOpen}"
                            Stroke="{StaticResource PaperEdge}"
                            StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding StampDesignChoices}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:StampDesignChoice">
                                        <Grid
                                            Padding="10,6"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PickStampDesignCommand, Source={x:Reference settingsPage}, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <controls:StampFrame
                                                HeightRequest="28"
                                                IsSmall="True"
                                                Pattern="{Binding Pattern}"
                                                WidthRequest="36" />
                                            <Label
                                                Grid.Column="1"
                                                FontSize="15"
                                                Text="{Binding Name}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="2"
                                                FontSize="16"
                                                IsVisible="{Binding IsSelected}"
                                                Style="{StaticResource SettingsCheck}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Label Style="{StaticResource SettingsSubheading}" Text="{x:Static strings:AppResources.StampTilt}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label FontSize="16" Text="{x:Static strings:AppResources.StampTiltOn}" />
                        <Label FontSize="12" Text="{x:Static strings:AppResources.StampTiltHint}" TextColor="{StaticResource InkMuted}" />
                    </VerticalStackLayout>
                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding StampTilt}"
                        OnColor="{StaticResource Navy}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  Subscription  -->
            <controls:StampLabel Style="{StaticResource StampHeading}" Text="{x:Static strings:AppResources.SubscriptionStatus}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label
                        FontSize="16"
                        Text="{Binding SubscriptionStatusText}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding ManageSubscriptionCommand}"
                        Text="{x:Static strings:AppResources.Subscribe}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  Backup and restore  -->
            <controls:StampLabel Style="{StaticResource StampHeading}" Text="{x:Static strings:AppResources.Data}" />
            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CreateBackUpCommand}" />
                        </Grid.GestureRecognizers>
                        <Label
                            FontSize="16"
                            Text="{x:Static strings:AppResources.CreateBackup}"
                            VerticalOptions="Center" />
                        <Label Grid.Column="1" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RestoreBackUpCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label
                                FontSize="16"
                                Text="{x:Static strings:AppResources.RestoreBackup}"
                                TextColor="{StaticResource Stamp}" />
                            <Label
                                FontSize="12"
                                Text="{x:Static strings:AppResources.RestoreBeforeUse}"
                                TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  Advanced: own Google Maps API key  -->
            <controls:StampLabel Style="{StaticResource StampHeading}" Text="{x:Static strings:AppResources.Advanced}" />
            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Padding="14,12" Spacing="6">
                    <Label
                        FontSize="16"
                        Text="Google Maps API Key" />
                    <!--  A label, not the entry's placeholder: a placeholder is one line and gets cut  -->
                    <Label
                        FontSize="12"
                        Text="{x:Static strings:AppResources.SpecifyAPI}"
                        TextColor="{StaticResource InkMuted}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Entry
                            IsPassword="True"
                            Text="{Binding ApiKey}"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Navy}"
                            BorderWidth="1"
                            Command="{Binding EnableApiKeyCommand}"
                            Text="{x:Static strings:AppResources.Enable}"
                            TextColor="{StaticResource Navy}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  Information  -->
            <controls:StampLabel Style="{StaticResource StampHeading}" Text="{x:Static strings:AppResources.Information}" />
            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowHowToUseCommand}" />
                        </Grid.GestureRecognizers>
                        <Label
                            FontSize="16"
                            Text="{x:Static strings:AppResources.HowToUse}"
                            VerticalOptions="Center" />
                        <Label Grid.Column="1" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTermsOfUseCommand}" />
                        </Grid.GestureRecognizers>
                        <Label
                            FontSize="16"
                            Text="{x:Static strings:AppResources.TermsOfUse}"
                            VerticalOptions="Center" />
                        <Label Grid.Column="1" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPrivacyPolicyCommand}" />
                        </Grid.GestureRecognizers>
                        <Label
                            FontSize="16"
                            Text="{x:Static strings:AppResources.PrivacyPolicy}"
                            VerticalOptions="Center" />
                        <Label Grid.Column="1" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
