<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="FlagsRally.Views.CustomLocationImagePopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:CustomLocationImagePopupViewModel"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Margin="0,1,0,0"
    HorizontalOptions="Fill"
    VerticalOptions="Center">
    <Grid Padding="20" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:StampLabel
            Grid.Row="0"
            FontAutoScalingEnabled="True"
            FontSize="Title"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Style="{StaticResource StampHeading}"
            Text="{Binding LocationTitle}" />
        <Image
            x:Name="stampImage"
            Grid.Row="1"
            Aspect="AspectFit"
            HeightRequest="{Binding Height}"
            Source="{Binding ImageUrl}" />
        <!--  Started in code once the stamp has loaded, so the confetti does not fall on an empty frame  -->
        <skia:SKLottieView
            x:Name="celebration"
            Grid.Row="0"
            Grid.RowSpan="2"
            HeightRequest="{Binding Height}"
            HorizontalOptions="Fill"
            IsAnimationEnabled="False"
            IsVisible="False"
            RepeatMode="Restart"
            Source="celebration.json"
            VerticalOptions="Center" />
        <Button
            Grid.Row="2"
            Command="{Binding ClosePopupCommand}"
            HorizontalOptions="Center"
            Text="OK"
            WidthRequest="100" />
    </Grid>
</toolkit:Popup>