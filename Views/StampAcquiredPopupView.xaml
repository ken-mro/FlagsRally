<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="FlagsRally.Views.StampAcquiredPopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    xmlns:views="clr-namespace:FlagsRally.Views"
    x:DataType="viewmodels:StampAcquiredPopupViewModel"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Style="{StaticResource StampPopup}">
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto"
        RowSpacing="14">
        <!--  Each page's stamp is pressed down as it comes in (see code-behind)  -->
        <views:StampSlidesView x:Name="slides" />

        <!--  On once every page has been pressed  -->
        <Button
            Grid.Row="1"
            Command="{Binding ClosePopupCommand}"
            IsEnabled="{Binding CanClose}"
            Style="{StaticResource PopupOkButton}"
            Text="OK" />
    </Grid>
</toolkit:Popup>
