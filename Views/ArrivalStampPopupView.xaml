<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="FlagsRally.Views.ArrivalStampPopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    xmlns:views="clr-namespace:FlagsRally.Views"
    x:DataType="viewmodels:ArrivalStampPopupViewModel"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Style="{StaticResource StampPopup}">
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto"
        RowSpacing="14">
        <!--  The country's stamp, then the region's on the next page  -->
        <views:StampSlidesView />

        <Button
            Grid.Row="1"
            Command="{Binding ClosePopupCommand}"
            Style="{StaticResource PopupOkButton}"
            Text="OK" />
    </Grid>
</toolkit:Popup>
