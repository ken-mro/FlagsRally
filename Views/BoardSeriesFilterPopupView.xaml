<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="FlagsRally.Views.BoardSeriesFilterPopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:Name="popup"
    x:DataType="viewmodels:BoardSeriesFilterViewModel"
    BackgroundColor="{StaticResource PaperCard}"
    CanBeDismissedByTappingOutsideOfPopup="True"
    HorizontalOptions="Fill"
    VerticalOptions="Center">
    <!--  Boards, ticked when their pins are shown on the map; a series' boards in a group that opens  -->
    <Grid
        Padding="20,18,20,14"
        RowDefinitions="Auto,Auto,Auto,Auto"
        RowSpacing="10">
        <controls:StampLabel
            LineBreakMode="WordWrap"
            Style="{StaticResource StampHeading}"
            Text="{Binding Title}" />
        <!--  Select all / Clear selection side by side, on two rows when they do not fit  -->
        <FlexLayout
            Grid.Row="1"
            AlignItems="Center"
            Wrap="Wrap">
            <Button
                Margin="0,0,8,4"
                Padding="12,0"
                BackgroundColor="Transparent"
                BorderColor="{StaticResource Navy}"
                BorderWidth="1"
                Command="{Binding ShowAllCommand}"
                Text="{x:Static strings:AppResources.SelectAllBoards}"
                TextColor="{StaticResource Navy}" />
            <Button
                Margin="0,0,8,4"
                Padding="12,0"
                BackgroundColor="Transparent"
                BorderColor="{StaticResource Navy}"
                BorderWidth="1"
                Command="{Binding HideAllCommand}"
                Text="{x:Static strings:AppResources.ClearBoardSelection}"
                TextColor="{StaticResource Navy}" />
        </FlexLayout>
        <ScrollView x:Name="boards" Grid.Row="2">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:PinFilterNode">
                        <!--  ▸ / ▾, the name (and for a group how many of its boards are shown), the tick box.
                              A group's name opens or closes it and its tick box shows or hides all of its
                              boards; a board's whole row toggles it.  -->
                        <Grid
                            Padding="{Binding Indent}"
                            ColumnDefinitions="24,*,Auto"
                            ColumnSpacing="4"
                            MinimumHeightRequest="48">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.TapRowCommand, Source={x:Reference popup}, x:DataType=toolkit:Popup}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Path
                                Data="M1,0 L9,5 L1,10 Z"
                                Fill="{StaticResource Ink}"
                                HeightRequest="10"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsGroup}"
                                Rotation="{Binding ExpandRotation}"
                                VerticalOptions="Center"
                                WidthRequest="10" />
                            <Label
                                Grid.Column="1"
                                FontSize="16"
                                LineBreakMode="WordWrap"
                                VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Name}" />
                                        <Span Text="&#x00A0;&#x00A0;" />
                                        <Span
                                            FontSize="13"
                                            Text="{Binding CountText}"
                                            TextColor="{StaticResource InkMuted}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <!--  Tick box with three states, as in the Windows features dialog: ticked (all
                                  shown), filled square (some shown), empty (none)  -->
                            <controls:TickBox
                                Grid.Column="2"
                                Command="{Binding BindingContext.ToggleShownCommand, Source={x:Reference popup}, x:DataType=toolkit:Popup}"
                                CommandParameter="{Binding .}"
                                Description="{Binding Name}"
                                IsChecked="{Binding IsAllShown, Mode=OneWay}"
                                IsPartlyChecked="{Binding IsSomeShown}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
        <Button
            Grid.Row="3"
            Command="{Binding CloseCommand}"
            HorizontalOptions="End"
            MinimumWidthRequest="100"
            Text="{x:Static strings:AppResources.Close}" />
    </Grid>
</toolkit:Popup>
