<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.ManageCustomBoardsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    Title="{Binding Title}"
    x:DataType="viewmodels:ManageCustomBoardsPageViewModel">
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{x:Static strings:AppResources.ManageBoards}" />
    </Shell.TitleView>
    <Grid Padding="10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CollectionView Grid.Row="0" ItemsSource="{Binding Boards}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ManageableBoardItem">
                    <Grid Padding="5,8" ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Grid.Column="0"
                            IsChecked="{Binding IsSelected}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontSize="16"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Name}"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="2"
                            Padding="0"
                            BackgroundColor="Transparent"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ManageCustomBoardsPageViewModel}}, x:DataType=viewmodels:ManageCustomBoardsPageViewModel, Path=MoveUpCommand}"
                            CommandParameter="{Binding .}"
                            FontSize="18"
                            SemanticProperties.Description="{x:Static strings:AppResources.MoveUp}"
                            Text="▲"
                            TextColor="Gray"
                            WidthRequest="44" />
                        <Button
                            Grid.Column="3"
                            Padding="0"
                            BackgroundColor="Transparent"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ManageCustomBoardsPageViewModel}}, x:DataType=viewmodels:ManageCustomBoardsPageViewModel, Path=MoveDownCommand}"
                            CommandParameter="{Binding .}"
                            FontSize="18"
                            SemanticProperties.Description="{x:Static strings:AppResources.MoveDown}"
                            Text="▼"
                            TextColor="Gray"
                            WidthRequest="44" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button
            Grid.Row="1"
            BackgroundColor="{AppThemeBinding Light='#C62828', Dark='#EF5350'}"
            Command="{Binding DeleteSelectedCommand}"
            IsEnabled="{Binding HasSelection}"
            Text="{Binding DeleteSelectedText}"
            TextColor="White">
            <Button.Triggers>
                <DataTrigger
                    Binding="{Binding HasSelection}"
                    TargetType="Button"
                    Value="False">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
        <ActivityIndicator
            Grid.Row="0"
            HeightRequest="50"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="Gray" />
    </Grid>
</ContentPage>
