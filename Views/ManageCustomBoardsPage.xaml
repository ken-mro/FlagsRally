<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.ManageCustomBoardsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    Title="{Binding Title}"
    x:DataType="viewmodels:ManageCustomBoardsPageViewModel"
    Style="{StaticResource PaperPage}">
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{x:Static strings:AppResources.ManageBoards}" />
    </Shell.TitleView>
    <Grid Padding="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label
            Grid.Row="0"
            FontSize="13"
            Text="{x:Static strings:AppResources.DragToReorder}"
            TextColor="{StaticResource InkMuted}" />
        <ScrollView x:Name="scrollView" Grid.Row="1">
            <Border
                Padding="0"
                BackgroundColor="{StaticResource PaperCard}"
                StrokeShape="RoundRectangle 10"
                VerticalOptions="Start">
                <!--  Rows are reordered by dragging the handle on the right (see code-behind).  -->
                <VerticalStackLayout x:Name="boardList" BindableLayout.ItemsSource="{Binding Boards}">
                    <VerticalStackLayout.GestureRecognizers>
                        <PointerGestureRecognizer PointerPressed="OnListPointerPressed" />
                        <PanGestureRecognizer PanUpdated="OnListPanUpdated" />
                    </VerticalStackLayout.GestureRecognizers>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ManageableBoardItem">
                            <Grid
                                Padding="6,4,0,4"
                                BackgroundColor="{StaticResource PaperCard}"
                                ColumnSpacing="4"
                                HeightRequest="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{Binding IsSelected}"
                                    VerticalOptions="Center" />
                                <!--  Two lines fit in the row; the rows keep one height because dragging steps by it  -->
                                <Label
                                    Grid.Column="1"
                                    FontSize="16"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Name}"
                                    VerticalOptions="Center" />
                                <!--  Drag handle (the drag itself is handled by the list, see code-behind)  -->
                                <Grid
                                    Grid.Column="2"
                                    InputTransparent="True"
                                    SemanticProperties.Description="{x:Static strings:AppResources.DragToReorder}">
                                    <Label
                                        FontSize="26"
                                        HorizontalOptions="Center"
                                        InputTransparent="True"
                                        Text="≡"
                                        TextColor="{StaticResource InkMuted}"
                                        VerticalOptions="Center" />
                                </Grid>
                                <BoxView
                                    Grid.ColumnSpan="3"
                                    Margin="40,0,0,-4"
                                    HeightRequest="1"
                                    VerticalOptions="End"
                                    Color="{StaticResource PaperEdge}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
        <Button
            Grid.Row="2"
            BackgroundColor="{StaticResource Stamp}"
            Command="{Binding DeleteSelectedCommand}"
            IsEnabled="{Binding HasSelection}"
            Text="{Binding DeleteSelectedText}"
            TextColor="White">
            <Button.Triggers>
                <DataTrigger
                    Binding="{Binding HasSelection}"
                    TargetType="Button"
                    Value="False">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
        <ActivityIndicator
            Grid.Row="1"
            HeightRequest="50"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Navy}" />
    </Grid>
</ContentPage>
