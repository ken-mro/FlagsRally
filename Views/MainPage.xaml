<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.MainPage"
    x:Name="page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:converters="clr-namespace:FlagsRally.Converters"
    xmlns:map="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    xmlns:views="clr-namespace:FlagsRally.Views"
    x:DataType="viewmodels:MainPageViewModel"
    Style="{StaticResource PaperPage}">
    <ContentPage.Resources>
        <converters:FontFamilyConverter x:Key="FontFamilyConverter" />
        <converters:FontSizeConverter x:Key="FontSizeConverter" />
        <Style x:Key="TitleStatIcon" TargetType="Image">
            <Setter Property="HeightRequest" Value="15" />
            <Setter Property="WidthRequest" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="TitleStatNumber" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource Gold}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="HeaderStatIcon" TargetType="Image">
            <Setter Property="HeightRequest" Value="20" />
            <Setter Property="WidthRequest" Value="20" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style x:Key="HeaderStatNumber" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontFamily" Value="craftmincho" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource Navy}" />
        </Style>
        <Style x:Key="HeaderStatLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        </Style>

        <!--  The original stamp: a solid square with a dashed one inside  -->
        <DataTemplate x:Key="SquareStamp" x:DataType="{x:Type models:ArrivalLocation}">
            <SwipeView>
                <SwipeView.LeftItems>
                    <SwipeItem
                        BackgroundColor="{StaticResource Stamp}"
                        Command="{Binding ViewModel.DeleteArrivalLocationCommand, Source={x:Reference page}, x:DataType=views:MainPage}"
                        CommandParameter="{Binding .}"
                        IconImageSource="eraser.png"
                        Text="{x:Static strings:AppResources.Delete}" />
                </SwipeView.LeftItems>
                <Border
                    Margin="{Binding StampMargin}"
                    BackgroundColor="Transparent"
                    Rotation="{Binding StampTilt}"
                    Stroke="{StaticResource Ink}"
                    StrokeShape="Rectangle"
                    StrokeThickness="4">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewModel.ShowLocationInfoCommand, Source={x:Reference page}, x:DataType=views:MainPage}" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Border
                        Margin="2"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource Ink}"
                        StrokeDashArray="2,2"
                        StrokeShape="Rectangle"
                        StrokeThickness="2">
                        <VerticalStackLayout VerticalOptions="Center">
                            <FlyoutBase.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Command="{Binding ViewModel.DeleteArrivalLocationCommand, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        CommandParameter="{Binding .}"
                                        IconImageSource="eraser.png"
                                        IsDestructive="True"
                                        Text="{x:Static strings:AppResources.Delete}" />
                                </MenuFlyout>
                            </FlyoutBase.ContextFlyout>
                            <OnPlatform x:TypeArguments="View">
                                <On Platform="MacCatalyst, iOS, Android">
                                    <Label
                                        Margin="-2"
                                        FontSize="47"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        Text="{Binding CountryFlagSource}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding AdminAreaFlagSource}"
                                                TargetType="Label"
                                                Value="">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </On>
                                <On Platform="Android">
                                    <Label
                                        FontSize="45"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        Text="{Binding CountryFlagSource}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding AdminAreaFlagSource}"
                                                TargetType="Label"
                                                Value="">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </On>
                                <On Platform="WinUI">
                                    <Image
                                        Margin="10"
                                        HeightRequest="40"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        Source="{Binding CountryFlagSource}"
                                        VerticalOptions="Center" />
                                </On>
                            </OnPlatform>
                            <!--  A fixed box (flags up to 2:1 keep their 40 height), so a flag arriving does not lay out the stamp again  -->
                            <Image
                                Margin="10"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ViewModel.IsAdminArea, Source={x:Reference page}, x:DataType=views:MainPage}"
                                Source="{Binding AdminAreaFlagSource}"
                                VerticalOptions="Center"
                                WidthRequest="80">
                                <Image.Triggers>
                                    <!--  Hidden while the stamps show countries: do not load the region's flag then  -->
                                    <DataTrigger
                                        Binding="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        TargetType="Image"
                                        Value="True">
                                        <Setter Property="Source" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding AdminAreaFlagSource}"
                                        TargetType="Image"
                                        Value="">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Label
                                Padding="2,0"
                                FontAttributes="Bold"
                                FontFamily="{Binding CountryName, Converter={StaticResource FontFamilyConverter}}"
                                FontSize="{Binding CountryName, Converter={StaticResource FontSizeConverter}}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                LineBreakMode="CharacterWrap"
                                LineHeight="1"
                                MaxLines="2"
                                Text="{Binding CountryName}"
                                TextColor="{StaticResource Ink}"
                                VerticalOptions="Center" />
                            <Label
                                Padding="2,0"
                                FontAttributes="Bold"
                                FontFamily="{Binding AdminAreaName, Converter={StaticResource FontFamilyConverter}}"
                                FontSize="{Binding CountryName, Converter={StaticResource FontSizeConverter}}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding ViewModel.IsAdminArea, Source={x:Reference page}, x:DataType=views:MainPage}"
                                LineBreakMode="CharacterWrap"
                                LineHeight="1"
                                MaxLines="2"
                                Text="{Binding AdminAreaName}"
                                TextColor="{StaticResource Ink}"
                                VerticalOptions="Center" />
                            <Line
                                HorizontalOptions="Center"
                                Stroke="{StaticResource Ink}"
                                StrokeDashArray="2,2"
                                StrokeThickness="2"
                                X1="0"
                                X2="150"
                                Y1="0"
                                Y2="0" />
                            <controls:OneLineFittingLabel
                                Margin="8,0"
                                FontAttributes="Bold"
                                FontFamily="craftmincho"
                                FontSize="Body"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ViewModel.DateIsVisible, Source={x:Reference page}, x:DataType=views:MainPage}"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                Text="{Binding ArrivalDateString}"
                                TextColor="{StaticResource Stamp}"
                                VerticalOptions="Center" />
                            <controls:OneLineFittingLabel
                                Margin="8,0"
                                FontAttributes="Bold"
                                FontFamily="craftmincho"
                                FontSize="Body"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ViewModel.DateIsNotVisible, Source={x:Reference page}, x:DataType=views:MainPage}"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                Text="{Binding ArrivalDate, StringFormat='DD Mmm {0:yyyy}'}"
                                TextColor="{StaticResource Stamp}"
                                VerticalOptions="Center" />
                            <Line
                                HorizontalOptions="Center"
                                Stroke="{StaticResource Ink}"
                                StrokeDashArray="2,2"
                                StrokeThickness="2"
                                X1="0"
                                X2="120"
                                Y1="0"
                                Y2="0" />
                            <Label
                                FontAttributes="Bold"
                                FontAutoScalingEnabled="True"
                                FontFamily="JerseyclubGrungeBold"
                                FontSize="40"
                                HorizontalOptions="Center"
                                LineBreakMode="NoWrap"
                                Text="ARRIVAL"
                                TextColor="{StaticResource Ink}"
                                VerticalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Border>
            </SwipeView>
        </DataTemplate>
        <!--  The other patterns: StampFrame draws the outline in the pattern's ink, the text sits on top  -->
        <DataTemplate x:Key="ShapedStamp" x:DataType="{x:Type models:ArrivalLocation}">
            <SwipeView>
                <SwipeView.LeftItems>
                    <SwipeItem
                        BackgroundColor="{StaticResource Stamp}"
                        Command="{Binding ViewModel.DeleteArrivalLocationCommand, Source={x:Reference page}, x:DataType=views:MainPage}"
                        CommandParameter="{Binding .}"
                        IconImageSource="eraser.png"
                        Text="{x:Static strings:AppResources.Delete}" />
                </SwipeView.LeftItems>
                <Grid Margin="{Binding StampMargin}" Rotation="{Binding StampTilt}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewModel.ShowLocationInfoCommand, Source={x:Reference page}, x:DataType=views:MainPage}" CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                    <controls:StampFrame Pattern="{Binding StampPattern}" Seed="{Binding Id}" />
                    <Grid>
                        <VerticalStackLayout Padding="{Binding StampPadding}" VerticalOptions="Center">
                            <FlyoutBase.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Command="{Binding ViewModel.DeleteArrivalLocationCommand, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        CommandParameter="{Binding .}"
                                        IconImageSource="eraser.png"
                                        IsDestructive="True"
                                        Text="{x:Static strings:AppResources.Delete}" />
                                </MenuFlyout>
                            </FlyoutBase.ContextFlyout>
                            <OnPlatform x:TypeArguments="View">
                                <On Platform="MacCatalyst, iOS, Android">
                                    <Label
                                        Margin="-2"
                                        FontSize="47"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        Text="{Binding CountryFlagSource}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding AdminAreaFlagSource}"
                                                TargetType="Label"
                                                Value="">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </On>
                                <On Platform="Android">
                                    <Label
                                        FontSize="45"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        Text="{Binding CountryFlagSource}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding AdminAreaFlagSource}"
                                                TargetType="Label"
                                                Value="">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </On>
                                <On Platform="WinUI">
                                    <Image
                                        Margin="10"
                                        HeightRequest="40"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        Source="{Binding CountryFlagSource}"
                                        VerticalOptions="Center" />
                                </On>
                            </OnPlatform>
                            <!--  A fixed box (flags up to 2:1 keep their 40 height), so a flag arriving does not lay out the stamp again  -->
                            <Image
                                Margin="10"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ViewModel.IsAdminArea, Source={x:Reference page}, x:DataType=views:MainPage}"
                                Source="{Binding AdminAreaFlagSource}"
                                VerticalOptions="Center"
                                WidthRequest="80">
                                <Image.Triggers>
                                    <!--  Hidden while the stamps show countries: do not load the region's flag then  -->
                                    <DataTrigger
                                        Binding="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                        TargetType="Image"
                                        Value="True">
                                        <Setter Property="Source" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding AdminAreaFlagSource}"
                                        TargetType="Image"
                                        Value="">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Label
                                Padding="2,0"
                                FontAttributes="Bold"
                                FontFamily="{Binding CountryName, Converter={StaticResource FontFamilyConverter}}"
                                FontSize="{Binding CountryName, Converter={StaticResource FontSizeConverter}}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding ViewModel.IsCountry, Source={x:Reference page}, x:DataType=views:MainPage}"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                MaxLines="2"
                                Text="{Binding CountryName}"
                                TextColor="{Binding StampInk}"
                                VerticalOptions="Center" />
                            <Label
                                Padding="2,0"
                                FontAttributes="Bold"
                                FontFamily="{Binding AdminAreaName, Converter={StaticResource FontFamilyConverter}}"
                                FontSize="{Binding CountryName, Converter={StaticResource FontSizeConverter}}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding ViewModel.IsAdminArea, Source={x:Reference page}, x:DataType=views:MainPage}"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                MaxLines="2"
                                Text="{Binding AdminAreaName}"
                                TextColor="{Binding StampInk}"
                                VerticalOptions="Center" />
                            <Line
                                HorizontalOptions="Center"
                                Stroke="{Binding StampInk}"
                                StrokeDashArray="2,2"
                                StrokeThickness="2"
                                X1="0"
                                X2="{Binding StampLongLine}"
                                Y1="0"
                                Y2="0" />
                            <controls:OneLineFittingLabel
                                Margin="8,0"
                                FontAttributes="Bold"
                                FontFamily="craftmincho"
                                FontSize="Body"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ViewModel.DateIsVisible, Source={x:Reference page}, x:DataType=views:MainPage}"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                Text="{Binding ArrivalDateString}"
                                TextColor="{Binding StampDateInk}"
                                VerticalOptions="Center" />
                            <controls:OneLineFittingLabel
                                Margin="8,0"
                                FontAttributes="Bold"
                                FontFamily="craftmincho"
                                FontSize="Body"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ViewModel.DateIsNotVisible, Source={x:Reference page}, x:DataType=views:MainPage}"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                Text="{Binding ArrivalDate, StringFormat='DD Mmm {0:yyyy}'}"
                                TextColor="{Binding StampDateInk}"
                                VerticalOptions="Center" />
                            <Line
                                HorizontalOptions="Center"
                                Stroke="{Binding StampInk}"
                                StrokeDashArray="2,2"
                                StrokeThickness="2"
                                X1="0"
                                X2="{Binding StampShortLine}"
                                Y1="0"
                                Y2="0" />
                            <Label
                                FontAttributes="Bold"
                                FontAutoScalingEnabled="False"
                                FontFamily="JerseyclubGrungeBold"
                                FontSize="{Binding StampArrivalFontSize}"
                                HorizontalOptions="Center"
                                LineBreakMode="NoWrap"
                                Text="ARRIVAL"
                                TextColor="{Binding StampInk}"
                                VerticalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </SwipeView>
        </DataTemplate>
    </ContentPage.Resources>
    <!--  Once the passport has scrolled away, its numbers move up beside the title as icon + number
          pairs (the same icons as in the passport header), which stay on one line in any language.  -->
    <Shell.TitleView>
        <Grid
            Padding="0,0,12,0"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="10">
            <controls:StampLabel Style="{StaticResource StampTitle}" Text="{x:Static strings:AppResources.TabPassport}" />
            <Border
                Grid.Column="1"
                Padding="12,5"
                BackgroundColor="{StaticResource NavyDeep}"
                HorizontalOptions="End"
                IsVisible="{Binding ShowsSummaryInTitle}"
                SemanticProperties.Description="{Binding SummaryText}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                VerticalOptions="Center">
                <HorizontalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="4">
                        <Image Source="stat_arrivals.png" Style="{StaticResource TitleStatIcon}">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource Gold}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Style="{StaticResource TitleStatNumber}" Text="{Binding ArrivalCount}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Image Source="stat_countries.png" Style="{StaticResource TitleStatIcon}">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource Gold}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Style="{StaticResource TitleStatNumber}" Text="{Binding VisitedCountryCount}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Image Source="stat_regions.png" Style="{StaticResource TitleStatIcon}">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource Gold}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Style="{StaticResource TitleStatNumber}" Text="{Binding VisitedRegionCount}" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Shell.TitleView>
    <Grid RowDefinitions="Auto,*">

        <!--  Stamps; the passport and the filter bar scroll with them  -->
        <CollectionView
            x:Name="collectionView"
            Grid.RowSpan="2"
            Background="Transparent"
            IsVisible="{Binding IsListVisible}"
            ItemsSource="{Binding DisplayArrivalLocationList}"
            Scrolled="OnStampsScrolled">
            <CollectionView.Header>
                <VerticalStackLayout>
                    <!--  On a narrow screen with large text the counts do not fit beside the cover;
                          they then take a row of their own below it (see code-behind)  -->
                    <Grid
                        x:Name="passportHeader"
                        Padding="16,16,16,12"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="16"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="12">
                        <Border
                            x:Name="passportCover"
                            HeightRequest="116"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="0"
                            WidthRequest="84">
                            <Image Aspect="AspectFill" Source="{Binding PassportImageSourceString}" />
                        </Border>
                        <!--  Arrivals (stamps), countries and regions on a card with a dashed edge like the
                              stamps; each icon is the one the title bar uses for that count once the header
                              has scrolled away. The arrivals flag matches the arrival pins on the map.  -->
                        <Border
                            x:Name="statsCard"
                            Grid.Column="1"
                            Padding="4,10"
                            BackgroundColor="{StaticResource PaperCard}"
                            Stroke="{StaticResource PaperEdge}"
                            StrokeDashArray="4,3"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1.5"
                            VerticalOptions="Center">
                            <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                                <VerticalStackLayout
                                    x:Name="arrivalsStat"
                                    Grid.Column="0"
                                    Spacing="2">
                                    <Image Source="stat_arrivals.png" Style="{StaticResource HeaderStatIcon}" />
                                    <Label Style="{StaticResource HeaderStatNumber}" Text="{Binding ArrivalCount}" />
                                    <Label Style="{StaticResource HeaderStatLabel}" Text="{x:Static strings:AppResources.StatArrivals}" />
                                </VerticalStackLayout>
                                <BoxView
                                    Grid.Column="1"
                                    Margin="0,6"
                                    WidthRequest="1"
                                    Color="{StaticResource PaperEdge}" />
                                <VerticalStackLayout
                                    x:Name="countriesStat"
                                    Grid.Column="2"
                                    Spacing="2">
                                    <Image Source="stat_countries.png" Style="{StaticResource HeaderStatIcon}" />
                                    <Label Style="{StaticResource HeaderStatNumber}" Text="{Binding VisitedCountryCount}" />
                                    <Label Style="{StaticResource HeaderStatLabel}" Text="{x:Static strings:AppResources.StatCountries}" />
                                </VerticalStackLayout>
                                <BoxView
                                    Grid.Column="3"
                                    Margin="0,6"
                                    WidthRequest="1"
                                    Color="{StaticResource PaperEdge}" />
                                <VerticalStackLayout
                                    x:Name="regionsStat"
                                    Grid.Column="4"
                                    Spacing="2">
                                    <Image Source="stat_regions.png" Style="{StaticResource HeaderStatIcon}" />
                                    <Label Style="{StaticResource HeaderStatNumber}" Text="{Binding VisitedRegionCount}" />
                                    <Label Style="{StaticResource HeaderStatLabel}" Text="{x:Static strings:AppResources.StatRegions}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!--  Room for the floating toolbar so the last stamps can scroll above it
                  (follows the toolbar, which takes two rows on a narrow screen)  -->
            <CollectionView.Footer>
                <BoxView
                    x:Name="toolbarSpace"
                    BackgroundColor="Transparent"
                    HeightRequest="92" />
            </CollectionView.Footer>

            <!--  A blank passport page until the first arrival is recorded  -->
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="28,24"
                    Spacing="18"
                    IsVisible="{Binding HasNoArrivals}">
                    <Border
                        HeightRequest="170"
                        HorizontalOptions="Center"
                        Rotation="-3"
                        Stroke="{StaticResource PaperEdge}"
                        StrokeDashArray="4,3"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="2.5"
                        WidthRequest="150">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6" VerticalOptions="Center">
                            <Image
                                HeightRequest="40"
                                Opacity="0.35"
                                Source="location.png" />
                            <Label
                                FontFamily="JerseyclubGrungeBold"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                Text="ARRIVAL"
                                TextColor="{StaticResource PaperEdge}" />
                        </VerticalStackLayout>
                    </Border>
                    <Label
                        FontAttributes="Bold"
                        FontFamily="craftmincho"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static strings:AppResources.NoStampsYet}" />
                    <Label
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        LineHeight="1.3"
                        Text="{x:Static strings:AppResources.NoStampsHint}"
                        TextColor="{StaticResource InkMuted}" />
                    <Button
                        Command="{Binding GoToMapCommand}"
                        CornerRadius="24"
                        HorizontalOptions="Center"
                        Text="{x:Static strings:AppResources.StampFirstOnMap}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="{Binding GridItemSpan}" />
            </CollectionView.ItemsLayout>

            <!--  The original square stamp, or one drawn in another shape (Settings > Passport stamps)  -->
            <CollectionView.ItemTemplate>
                <views:StampTemplateSelector ShapedStamp="{StaticResource ShapedStamp}" SquareStamp="{StaticResource SquareStamp}" />
            </CollectionView.ItemTemplate>
        </CollectionView>


        <!--  The visited countries on a world map, in place of the stamps  -->
        <map:SfMaps
            Grid.Row="1"
            BackgroundColor="{StaticResource MapSea}"
            IsVisible="{Binding IsMapVisible}">
            <map:SfMaps.Layer>
                <map:MapShapeLayer
                    DataSource="{Binding MapArrivalLocationList}"
                    EnableSelection="True"
                    PrimaryValuePath="CountryCode"
                    ShapeColorValuePath="Id"
                    ShapeDataField="code"
                    ShapeFill="{StaticResource MapLand}"
                    ShapeStroke="{StaticResource PaperCard}"
                    ShapeStrokeThickness="1"
                    ShapesSource="{Binding ShapesSource}"
                    ShowShapeTooltip="True">
                    <map:MapShapeLayer.ColorMappings>
                        <map:RangeColorMapping
                            Color="{StaticResource Stamp}"
                            From="1"
                            To="2147483647" />
                    </map:MapShapeLayer.ColorMappings>
                    <map:MapShapeLayer.ShapeTooltipTemplate>
                        <DataTemplate x:DataType="map:MapTooltipInfo">
                            <VerticalStackLayout>
                                <Label
                                    HeightRequest="20"
                                    Text="{Binding DataItem.CountryFlagSource}"
                                    WidthRequest="20" />
                                <Label Text="{Binding DataItem.CountryName}" TextColor="White" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </map:MapShapeLayer.ShapeTooltipTemplate>
                    <map:MapShapeLayer.ZoomPanBehavior>
                        <map:MapZoomPanBehavior ZoomLevel="1" />
                    </map:MapShapeLayer.ZoomPanBehavior>
                </map:MapShapeLayer>
            </map:SfMaps.Layer>
        </map:SfMaps>

        <ActivityIndicator
            Grid.Row="1"
            HeightRequest="50"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Navy}" />

        <!--  Controls float just above the tab bar, within thumb reach, over the stamps or the map  -->
        <Border
            x:Name="toolbar"
            Grid.RowSpan="2"
            Margin="12,0,12,12"
            Padding="0"
            BackgroundColor="{StaticResource PaperCard}"
            Stroke="{StaticResource PaperEdge}"
            StrokeShape="RoundRectangle 30"
            StrokeThickness="1"
            VerticalOptions="End">
            <Border.Shadow>
                <Shadow
                    Brush="{StaticResource NavyDeep}"
                    Opacity="0.18"
                    Radius="14"
                    Offset="0,4" />
            </Border.Shadow>
            <controls:PassportFilterBar />
        </Border>
    </Grid>
</ContentPage>
