<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.CustomBoardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:converters="clr-namespace:FlagsRally.Converters"
    xmlns:customboard="clr-namespace:FlagsRally.Models.CustomBoard"
    xmlns:map="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:CustomBoardPageViewModel"
    Style="{StaticResource PaperPage}">
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{Binding FilteredCustomBoard.Name}" />
    </Shell.TitleView>
    <ContentPage.Resources>
        <converters:BoardFontSizeConverter x:Key="FontSizeConverter" />
    </ContentPage.Resources>
    <Grid Padding="5" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Progress  -->
        <Grid
            Grid.Row="0"
            Padding="6,6,6,0"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="{Binding ProgressText}" />
                <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Stamp}" />
            </VerticalStackLayout>
            <!--  Sort order  -->
            <Border
                Grid.Column="1"
                Padding="10,6"
                BackgroundColor="{StaticResource PaperCard}"
                SemanticProperties.Description="{x:Static strings:AppResources.SortBy}"
                Stroke="{StaticResource PaperEdge}"
                StrokeShape="RoundRectangle 16"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChooseSortCommand}" />
                </Border.GestureRecognizers>
                <Label
                    FontSize="13"
                    Text="{Binding SortText, StringFormat='⇅  {0}'}"
                    TextColor="{StaticResource Navy}" />
            </Border>
            <Image
                Grid.Column="2"
                Margin="5,0"
                HeightRequest="25"
                SemanticProperties.Description="{x:Static strings:AppResources.HideDateAndMonth}"
                Source="filter.png"
                VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeSettingsVisibilityCommand}" />
                </Image.GestureRecognizers>
            </Image>
        </Grid>

        <!--  All / Visited / Not visited, and display options  -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="6,0"
            Spacing="6">
            <controls:VisitFilterBar />
            <Grid IsVisible="{Binding IsSettingsVisible}">
                <Label
                    Padding="5,0"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="{x:Static strings:AppResources.HideDateAndMonth}"
                    VerticalOptions="Center" />
                <Switch
                    Margin="20,5"
                    HorizontalOptions="End"
                    IsToggled="{Binding DateIsNotVisible}"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCountriesCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView
                x:Name="collectionView"
                Background="Transparent"
                IsGrouped="True"
                ItemsSource="{Binding DisplayCustomLocationGroups}"
                VerticalOptions="Fill">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="viewmodels:CustomLocationGroup">
                        <Grid Padding="4,12,4,4" ColumnDefinitions="*,Auto">
                            <!--  Without a heading the header still takes space on Android, so collapse it  -->
                            <Grid.Triggers>
                                <DataTrigger
                                    Binding="{Binding HasHeading}"
                                    TargetType="Grid"
                                    Value="False">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HeightRequest" Value="0" />
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <controls:StampLabel
                                FontSize="18"
                                Text="{Binding Name}"
                                TextColor="{StaticResource Navy}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="13"
                                Text="{Binding ProgressText}"
                                TextColor="{StaticResource InkMuted}"
                                VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{Binding GridItemSpan}" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type customboard:CustomLocation}">
                        <Border
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource Ink}"
                            StrokeShape="Rectangle"
                            StrokeThickness="2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CustomBoardPageViewModel}}, x:DataType=viewmodels:CustomBoardPageViewModel, Path=ShowOnMapCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <StackLayout>
                                <Label
                                    Padding="2"
                                    FontFamily="KiwiMaru-Medium"
                                    FontSize="{Binding Title, Converter={StaticResource FontSizeConverter}}"
                                    HeightRequest="{Binding Board.Height}"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding HasNotBeenVisited}"
                                    LineBreakMode="MiddleTruncation"
                                    LineHeight="1"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    TextColor="{StaticResource InkMuted}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <VerticalStackLayout
                                    IsVisible="{Binding HasBeenVisited}"
                                    Spacing="{OnPlatform MacCatalyst=2,
                                                         iOS=2,
                                                         Default=0}"
                                    VerticalOptions="Center">
                                    <Image
                                        Aspect="AspectFit"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <Image.Source>
                                            <UriImageSource
                                                CacheValidity="30"
                                                CachingEnabled="True"
                                                Uri="{Binding ImageUrl}" />
                                        </Image.Source>
                                    </Image>
                                    <StackLayout BackgroundColor="{StaticResource Ink}">
                                        <Label
                                            FontFamily="KiwiMaru-Medium"
                                            FontSize="{Binding Title, Converter={StaticResource FontSizeConverter}}"
                                            HorizontalOptions="Center"
                                            LineBreakMode="MiddleTruncation"
                                            LineHeight="1"
                                            MaxLines="2"
                                            Text="{Binding Title}"
                                            TextColor="{StaticResource PaperCard}"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="Medium"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CustomBoardPageViewModel}}, x:DataType=viewmodels:CustomBoardPageViewModel, Path=DateIsVisible}"
                                        LineBreakMode="TailTruncation"
                                        LineHeight="1"
                                        Text="{Binding ArrivalDateString}"
                                        TextColor="{StaticResource Stamp}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="Medium"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CustomBoardPageViewModel}}, x:DataType=viewmodels:CustomBoardPageViewModel, Path=DateIsNotVisible}"
                                        LineBreakMode="TailTruncation"
                                        LineHeight="1"
                                        Text="{Binding ArrivalDate, StringFormat='DD  Mmm  {0:yyyy}'}"
                                        TextColor="{StaticResource Stamp}"
                                        VerticalOptions="Center" />
                                </VerticalStackLayout>
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator
            Grid.Row="2"
            Grid.ColumnSpan="2"
            HeightRequest="50"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Navy}" />
    </Grid>
</ContentPage>