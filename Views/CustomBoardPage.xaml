<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.CustomBoardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:converters="clr-namespace:FlagsRally.Converters"
    xmlns:customboard="clr-namespace:FlagsRally.Models.CustomBoard"
    xmlns:map="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:CustomBoardPageViewModel"
    Style="{StaticResource PaperPage}">
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{Binding FilteredCustomBoard.Name}" />
    </Shell.TitleView>
    <ContentPage.Resources>
        <converters:BoardFontSizeConverter x:Key="FontSizeConverter" />
    </ContentPage.Resources>
    <Grid Padding="5" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Progress  -->
        <Grid
            Grid.Row="0"
            Padding="6,6,6,0">
            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="{Binding ProgressText}" />
                <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Stamp}" />
            </VerticalStackLayout>
        </Grid>

        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCountriesCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView
                x:Name="collectionView"
                Background="Transparent"
                IsGrouped="True"
                ItemsSource="{Binding DisplayCustomLocationGroups}"
                VerticalOptions="Fill">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="viewmodels:CustomLocationGroup">
                        <Grid Padding="4,12,4,4" ColumnDefinitions="*,Auto">
                            <!--  Without a heading the header still takes space on Android, so collapse it  -->
                            <Grid.Triggers>
                                <DataTrigger
                                    Binding="{Binding HasHeading}"
                                    TargetType="Grid"
                                    Value="False">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HeightRequest" Value="0" />
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <controls:StampLabel
                                FontSize="18"
                                Text="{Binding Name}"
                                TextColor="{StaticResource Navy}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="13"
                                Text="{Binding ProgressText}"
                                TextColor="{StaticResource InkMuted}"
                                VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <!--  Room for the floating toolbar so the last tiles can scroll above it  -->
                <CollectionView.Footer>
                    <BoxView BackgroundColor="Transparent" HeightRequest="84" />
                </CollectionView.Footer>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{Binding GridItemSpan}" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type customboard:CustomLocation}">
                        <Border
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource Ink}"
                            StrokeShape="Rectangle"
                            StrokeThickness="2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CustomBoardPageViewModel}}, x:DataType=viewmodels:CustomBoardPageViewModel, Path=ShowOnMapCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <!--  An unvisited tile lays out the visited content too, unseen, so both are as tall as each other on every screen width  -->
                            <Grid>
                                <VerticalStackLayout
                                    Spacing="{OnPlatform MacCatalyst=2,
                                                         iOS=2,
                                                         Default=0}"
                                    VerticalOptions="Center">
                                    <VerticalStackLayout.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasNotBeenVisited}"
                                            TargetType="VerticalStackLayout"
                                            Value="True">
                                            <Setter Property="Opacity" Value="0" />
                                        </DataTrigger>
                                    </VerticalStackLayout.Triggers>
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CustomBoardPageViewModel}}, x:DataType=viewmodels:CustomBoardPageViewModel, Path=TileImageHeight}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <Image.Source>
                                            <UriImageSource
                                                CacheValidity="30"
                                                CachingEnabled="True"
                                                Uri="{Binding ImageUrl}" />
                                        </Image.Source>
                                    </Image>
                                    <StackLayout BackgroundColor="{StaticResource Ink}">
                                        <Label
                                            FontFamily="KiwiMaru-Medium"
                                            FontSize="{Binding Title, Converter={StaticResource FontSizeConverter}}"
                                            HorizontalOptions="Center"
                                            LineBreakMode="MiddleTruncation"
                                            LineHeight="1"
                                            MaxLines="2"
                                            Text="{Binding Title}"
                                            TextColor="{StaticResource PaperCard}"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="Medium"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CustomBoardPageViewModel}}, x:DataType=viewmodels:CustomBoardPageViewModel, Path=DateIsVisible}"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="WordWrap"
                                        LineHeight="1"
                                        Text="{Binding ArrivalDateString}"
                                        TextColor="{StaticResource Stamp}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="Medium"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CustomBoardPageViewModel}}, x:DataType=viewmodels:CustomBoardPageViewModel, Path=DateIsNotVisible}"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="WordWrap"
                                        LineHeight="1"
                                        Text="{Binding ArrivalDate, StringFormat='DD  Mmm  {0:yyyy}'}"
                                        TextColor="{StaticResource Stamp}"
                                        VerticalOptions="Center" />
                                </VerticalStackLayout>
                                <Label
                                    Padding="2"
                                    FontFamily="KiwiMaru-Medium"
                                    FontSize="{Binding Title, Converter={StaticResource FontSizeConverter}}"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding HasNotBeenVisited}"
                                    LineBreakMode="MiddleTruncation"
                                    LineHeight="1"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    TextColor="{StaticResource InkMuted}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator
            Grid.Row="1"
            Grid.ColumnSpan="2"
            HeightRequest="50"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Navy}" />
        <!--  Controls float just above the tab bar, within thumb reach, over the tiles  -->
        <Border
            Grid.RowSpan="2"
            Margin="7,0,7,7"
            Padding="8"
            BackgroundColor="{StaticResource PaperCard}"
            Stroke="{StaticResource PaperEdge}"
            StrokeShape="RoundRectangle 30"
            StrokeThickness="1"
            VerticalOptions="End">
            <Border.Shadow>
                <Shadow
                    Brush="{StaticResource NavyDeep}"
                    Opacity="0.18"
                    Radius="14"
                    Offset="0,4" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <controls:VisitFilterBar />
                <Border
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    HeightRequest="44"
                    SemanticProperties.Description="{x:Static strings:AppResources.SortBy}"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChooseSortCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="⇅"
                        TextColor="{StaticResource Navy}"
                        VerticalOptions="Center" />
                </Border>
                <ImageButton
                    Grid.Column="2"
                    Padding="11"
                    BackgroundColor="Transparent"
                    Command="{Binding ChooseDisplayOptionsCommand}"
                    HeightRequest="44"
                    SemanticProperties.Description="{x:Static strings:AppResources.DisplayOptions}"
                    Source="filter.png"
                    WidthRequest="44" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>