<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.LocationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:maps="clr-namespace:Maui.GoogleMaps;assembly=Maui.GoogleMaps"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:LocationPageViewModel">
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{x:Static strings:AppResources.Location}" />
    </Shell.TitleView>
    <Grid Padding="10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <maps:Map
            x:Name="map"
            Grid.Row="0"
            SelectedPin="{Binding SelectedPin}" />

        <!--  Default controls: filter and record the current location  -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding HasNoPinDetails}"
            Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Padding="10,8"
                    SemanticProperties.Description="{x:Static strings:AppResources.FilterPin}"
                    Stroke="{StaticResource InkMuted}"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPinFilterCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            HeightRequest="18"
                            Source="filter.png"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontSize="14"
                            LineBreakMode="TailTruncation"
                            Text="{Binding FilterSummary}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            Text="▾"
                            TextColor="{StaticResource InkMuted}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Label
                    Grid.Column="1"
                    FontSize="35"
                    HorizontalOptions="End"
                    Text="+"
                    TextColor="{StaticResource InkMuted}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddCustomBoardJsonCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
            <Button Command="{Binding GetCurrentLocationCommand}" Text="{x:Static strings:AppResources.GetLocation}" />
        </VerticalStackLayout>

        <!--  Details of the selected pin, with its actions as buttons  -->
        <Border
            Grid.Row="1"
            Padding="14,10,6,12"
            BackgroundColor="{StaticResource PaperCard}"
            IsVisible="{Binding HasPinDetails}"
            Stroke="{StaticResource PaperEdge}"
            StrokeShape="RoundRectangle 12">
            <Grid ColumnSpacing="4" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    LineBreakMode="TailTruncation"
                    Text="{Binding SelectedPinTitle}" />
                <Label
                    Grid.Row="1"
                    FontSize="13"
                    LineBreakMode="TailTruncation"
                    Text="{Binding SelectedPinSubtitle}"
                    TextColor="{StaticResource InkMuted}" />
                <Button
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Command="{Binding ClosePinDetailsCommand}"
                    FontSize="18"
                    SemanticProperties.Description="{x:Static strings:AppResources.Close}"
                    Text="✕"
                    TextColor="{StaticResource InkMuted}"
                    VerticalOptions="Start"
                    WidthRequest="44" />
                <Grid
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,8,8,0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        BackgroundColor="{StaticResource Stamp}"
                        Command="{Binding GetCurrentLocationCommand}"
                        IsVisible="{Binding CanCheckIn}"
                        Text="{x:Static strings:AppResources.CheckIn}" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Navy}"
                        BorderWidth="1"
                        Command="{Binding OpenDirectionsCommand}"
                        Text="{x:Static strings:AppResources.Directions}"
                        TextColor="{StaticResource Navy}" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="Transparent"
                        Command="{Binding RemoveSelectedPinCommand}"
                        IsVisible="{Binding CanRemoveSelectedPin}"
                        Text="{Binding RemoveSelectedPinText}"
                        TextColor="{StaticResource Stamp}" />
                </Grid>
            </Grid>
        </Border>

        <ActivityIndicator
            Grid.Row="0"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            WidthRequest="50"
            Color="{StaticResource Navy}" />
    </Grid>
</ContentPage>
