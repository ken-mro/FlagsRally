<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.LocationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:maps="clr-namespace:Maui.GoogleMaps;assembly=Maui.GoogleMaps"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:LocationPageViewModel"
    Style="{StaticResource PaperPage}">
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{x:Static strings:AppResources.TabMap}" />
    </Shell.TitleView>
    <Grid Padding="10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  The map keeps one size: the panels below float over its lower edge instead of taking
              rows from it, so showing or hiding them never moves the map. The padding keeps the
              Google logo above the Get Location button.  -->
        <maps:Map
            x:Name="map"
            Grid.Row="0"
            Grid.RowSpan="2"
            Padding="0,0,0,64"
            SelectedPin="{Binding SelectedPin}" />

        <!--  Map buttons at the bottom right, lifted above whichever panel is showing (see code-behind):
              directions and open-in-Maps for the place on the card, like Google's own toolbar, then zoom.  -->
        <VerticalStackLayout
            x:Name="mapButtons"
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="0,0,8,0"
            HorizontalOptions="End"
            Spacing="10"
            VerticalOptions="End"
            WidthRequest="48">
            <VerticalStackLayout IsVisible="{Binding ShowsMapActions}" Spacing="10">
                <Border
                    BackgroundColor="{StaticResource Navy}"
                    HeightRequest="48"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    WidthRequest="48">
                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource NavyDeep}"
                            Opacity="0.3"
                            Radius="8"
                            Offset="0,2" />
                    </Border.Shadow>
                    <ImageButton
                        Padding="12"
                        BackgroundColor="Transparent"
                        Command="{Binding OpenDirectionsCommand}"
                        SemanticProperties.Description="{x:Static strings:AppResources.Directions}"
                        Source="directions.png" />
                </Border>
                <Border
                    BackgroundColor="{StaticResource PaperCard}"
                    HeightRequest="48"
                    Stroke="{StaticResource PaperEdge}"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="1"
                    WidthRequest="48">
                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource NavyDeep}"
                            Opacity="0.18"
                            Radius="8"
                            Offset="0,2" />
                    </Border.Shadow>
                    <ImageButton
                        Padding="12"
                        BackgroundColor="Transparent"
                        Command="{Binding OpenInMapsCommand}"
                        SemanticProperties.Description="{x:Static strings:AppResources.OpenInMaps}"
                        Source="open_in_maps.png" />
                </Border>
            </VerticalStackLayout>
            <Border
                Padding="0"
                BackgroundColor="{StaticResource PaperCard}"
                Stroke="{StaticResource PaperEdge}"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="1">
                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource NavyDeep}"
                        Opacity="0.18"
                        Radius="8"
                        Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout>
                    <Button
                        Padding="0"
                        BackgroundColor="Transparent"
                        Command="{Binding ZoomInCommand}"
                        FontSize="24"
                        HeightRequest="48"
                        SemanticProperties.Description="{x:Static strings:AppResources.ZoomIn}"
                        Text="＋"
                        TextColor="{StaticResource Navy}" />
                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="{StaticResource PaperEdge}" />
                    <Button
                        Padding="0"
                        BackgroundColor="Transparent"
                        Command="{Binding ZoomOutCommand}"
                        FontSize="24"
                        HeightRequest="48"
                        SemanticProperties.Description="{x:Static strings:AppResources.ZoomOut}"
                        Text="−"
                        TextColor="{StaticResource Navy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!--  Filter chips over the map (right margin keeps the my-location button free)  -->
        <ScrollView
            Grid.Row="0"
            Margin="8,8,64,0"
            HorizontalScrollBarVisibility="Never"
            Orientation="Horizontal"
            VerticalOptions="Start">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding FilterChips}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:PinFilterChip">
                        <Border
                            Padding="12,6"
                            BackgroundColor="{StaticResource PaperCard}"
                            Stroke="{StaticResource PaperEdge}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSelected}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Navy}" />
                                    <Setter Property="Stroke" Value="{StaticResource Navy}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LocationPageViewModel}}, x:DataType=viewmodels:LocationPageViewModel, Path=ToggleFilterChipCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label
                                FontSize="13"
                                Text="{Binding Name}"
                                TextColor="{StaticResource Ink}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource PaperCard}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!--  Default controls: record the current location  -->
        <Grid
            x:Name="getLocationPanel"
            Grid.Row="1"
            ColumnSpacing="8"
            IsVisible="{Binding ShowsGetLocationButton}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{Binding GetCurrentLocationCommand}" Text="{x:Static strings:AppResources.GetLocation}" />
        </Grid>

        <!--  The check-in spot: how to move it, how far it is from you, and recording it  -->
        <Border
            x:Name="checkInSpotPanel"
            Grid.Row="1"
            Padding="14,10,6,12"
            BackgroundColor="{StaticResource PaperCard}"
            IsVisible="{Binding ShowsCheckInSpotGuide}"
            Stroke="{StaticResource PaperEdge}"
            StrokeShape="RoundRectangle 12">
            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="4">
                <Image
                    Grid.RowSpan="2"
                    HeightRequest="34"
                    Source="{Binding CheckInSpotIcon}"
                    VerticalOptions="Start"
                    WidthRequest="25" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="17"
                    LineBreakMode="WordWrap"
                    VerticalOptions="Center"
                    Text="{x:Static strings:AppResources.CheckInSpotTitle}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    FontSize="13"
                    Text="{Binding CheckInSpotHint}"
                    TextColor="{StaticResource InkMuted}" />
                <Button
                    Grid.Column="2"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Command="{Binding CancelCheckInSpotCommand}"
                    FontSize="18"
                    SemanticProperties.Description="{x:Static strings:AppResources.Close}"
                    Text="✕"
                    TextColor="{StaticResource InkMuted}"
                    VerticalOptions="Start"
                    WidthRequest="44" />
                <Label
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="{Binding CheckInSpotDistanceText}"
                    TextColor="{StaticResource Navy}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding CheckInSpotIsOutOfRange}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Stamp}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Button
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Margin="0,6,8,0"
                    Command="{Binding GetCurrentLocationCommand}"
                    Text="{x:Static strings:AppResources.CheckInHere}" />
            </Grid>
        </Border>

        <!--  Details of the selected pin, with its actions as buttons  -->
        <Border
            x:Name="pinDetailsPanel"
            Grid.Row="1"
            Padding="14,10,6,12"
            BackgroundColor="{StaticResource PaperCard}"
            IsVisible="{Binding HasPinDetails}"
            Stroke="{StaticResource PaperEdge}"
            StrokeShape="RoundRectangle 12">
            <Grid ColumnSpacing="4" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    LineBreakMode="WordWrap"
                    Text="{Binding SelectedPinTitle}" />
                <Label
                    Grid.Row="1"
                    FontSize="13"
                    LineBreakMode="WordWrap"
                    Text="{Binding SelectedPinSubtitle}"
                    TextColor="{StaticResource InkMuted}" />
                <Button
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Command="{Binding ClosePinDetailsCommand}"
                    FontSize="18"
                    SemanticProperties.Description="{x:Static strings:AppResources.Close}"
                    Text="✕"
                    TextColor="{StaticResource InkMuted}"
                    VerticalOptions="Start"
                    WidthRequest="44" />
                <!--  Wraps instead of squeezing: in Japanese or with large text the three
                      buttons do not fit on one line, and a squeezed button cuts its text.  -->
                <FlexLayout
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,4,8,0"
                    AlignItems="Center"
                    Wrap="Wrap">
                    <Button
                        Margin="0,4,8,0"
                        BackgroundColor="{StaticResource Stamp}"
                        Command="{Binding GetCurrentLocationCommand}"
                        FlexLayout.Grow="1"
                        IsVisible="{Binding CanCheckIn}"
                        Text="{x:Static strings:AppResources.CheckIn}" />
                    <Button
                        Margin="0,4,8,0"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Navy}"
                        BorderWidth="1"
                        Command="{Binding OpenDirectionsCommand}"
                        Text="{x:Static strings:AppResources.Directions}"
                        TextColor="{StaticResource Navy}" />
                    <Button
                        Margin="0,4,0,0"
                        BackgroundColor="Transparent"
                        Command="{Binding RemoveSelectedPinCommand}"
                        IsVisible="{Binding CanRemoveSelectedPin}"
                        Text="{Binding RemoveSelectedPinText}"
                        TextColor="{StaticResource Stamp}" />
                </FlexLayout>
            </Grid>
        </Border>

        <ActivityIndicator
            Grid.Row="0"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            WidthRequest="50"
            Color="{StaticResource Navy}" />
    </Grid>
</ContentPage>
