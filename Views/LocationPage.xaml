<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.LocationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Maui.GoogleMaps;assembly=Maui.GoogleMaps"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:LocationPageViewModel">
    <Grid Padding="10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label
            Grid.Row="0"
            HorizontalOptions="Center"
            Text="{x:Static strings:AppResources.ConfirmLocationTapButton}"
            VerticalOptions="Center">
            <Label.Triggers>
                <DataTrigger
                    Binding="{Binding SelectsCustomLocationPin}"
                    TargetType="Label"
                    Value="True">
                    <Setter Property="Text" Value="{x:Static strings:AppResources.TapCheckInNearTheSelectedPin}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <maps:Map
            x:Name="map"
            Grid.Row="1"
            SelectedPin="{Binding SelectedPin}" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Padding="10,8"
                SemanticProperties.Description="{x:Static strings:AppResources.FilterPin}"
                Stroke="Gray"
                StrokeShape="RoundRectangle 6"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPinFilterCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="18"
                        Source="filter.png"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontSize="14"
                        LineBreakMode="TailTruncation"
                        Text="{Binding FilterSummary}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        Text="▾"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
            <Label
                Grid.Column="1"
                FontSize="35"
                HorizontalOptions="End"
                Text="+"
                TextColor="Gray"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCustomBoardJsonCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
        <Button
            Grid.Row="3"
            BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                              Dark={StaticResource PrimaryDark}}"
            Command="{Binding GetCurrentLocationCommand}"
            Text="{x:Static strings:AppResources.GetLocation}">
            <Button.Triggers>
                <DataTrigger
                    Binding="{Binding SelectsCustomLocationPin}"
                    TargetType="Button"
                    Value="True">
                    <Setter Property="Text" Value="{x:Static strings:AppResources.CheckIn}" />
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light='#1E50A2', Dark='DodgerBlue'}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            WidthRequest="50"
            Color="Gray" />
    </Grid>
</ContentPage>