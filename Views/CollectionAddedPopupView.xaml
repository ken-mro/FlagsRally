<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="FlagsRally.Views.CollectionAddedPopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:CollectionAddedPopupViewModel"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Margin="0,1,0,0"
    HorizontalOptions="Fill"
    VerticalOptions="Center">
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="14">
        <controls:StampLabel
            FontAutoScalingEnabled="True"
            FontSize="Title"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Style="{StaticResource StampHeading}"
            Text="{x:Static strings:AppResources.AddedToCollection}" />

        <!--  The region's tile as the country's regional flags show it (FlagsBoardPage), pressed down,
              with the country's progress under it  -->
        <Grid Grid.Row="1" HeightRequest="320">
            <VerticalStackLayout Spacing="14" VerticalOptions="Center">
                <controls:ShrinkToFitLayout
                    x:Name="tile"
                    DesignWidth="160"
                    HorizontalOptions="Center"
                    MaxScale="1.3"
                    WidthRequest="208">
                    <Grid x:DataType="models:SubRegion" BindingContext="{Binding Region}">
                        <controls:CountryTileFrame CountryCode="{Binding Code.CountryCode}" />
                        <VerticalStackLayout
                            Padding="4,4,4,10"
                            Spacing="{OnPlatform MacCatalyst=2, iOS=2, Default=0}"
                            VerticalOptions="Center">
                            <Image
                                Margin="5"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                Source="{Binding FlagSource}"
                                VerticalOptions="Center"
                                WidthRequest="80" />
                            <Border
                                Padding="3,2"
                                BackgroundColor="{Binding Tile.Band}"
                                StrokeThickness="0">
                                <Border
                                    Padding="2,1"
                                    Stroke="{Binding Tile.BandLine}"
                                    StrokeShape="RoundRectangle 2"
                                    StrokeThickness="0.9">
                                    <controls:StampNameLabel
                                        FontAutoScalingEnabled="False"
                                        FontFamily="KiwiMaru-Medium"
                                        FontSize="19"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        LastFontSize="9"
                                        LineHeight="1"
                                        MinFontSize="14"
                                        Name="{Binding Name}"
                                        TextColor="{Binding Tile.BandText}"
                                        TwoLineMinFontSize="11"
                                        VerticalOptions="Center" />
                                </Border>
                            </Border>
                            <controls:OneLineFittingLabel
                                FontAttributes="Bold"
                                FontAutoScalingEnabled="False"
                                FontFamily="JerseyclubGrungeBold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                Text="{Binding ArrivalDateString}"
                                TextColor="{Binding Tile.Date}"
                                VerticalOptions="Center" />
                            <Line
                                HorizontalOptions="Center"
                                Stroke="{Binding Tile.Rule}"
                                StrokeThickness="2"
                                X1="0"
                                X2="120"
                                Y1="0"
                                Y2="0" />
                            <Label
                                FontAttributes="Bold"
                                FontAutoScalingEnabled="False"
                                FontFamily="JerseyclubGrungeBold"
                                FontSize="35"
                                HorizontalOptions="Center"
                                LineBreakMode="NoWrap"
                                Text="ARRIVAL"
                                TextColor="{Binding Tile.Arrival}"
                                VerticalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </controls:ShrinkToFitLayout>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="4" WidthRequest="208">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{Binding CountryName}"
                        TextColor="{StaticResource Ink}" />
                    <ProgressBar x:Name="progress" ProgressColor="{StaticResource Stamp}" />
                    <Label
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="{Binding ProgressText}"
                        TextColor="{StaticResource InkMuted}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
            <skia:SKLottieView
                x:Name="celebration"
                HorizontalOptions="Fill"
                InputTransparent="True"
                IsAnimationEnabled="False"
                IsVisible="False"
                RepeatCount="0"
                Source="celebration.json"
                VerticalOptions="Fill" />
        </Grid>

        <!--  On once the tile has been pressed and the bar has moved  -->
        <Button
            Grid.Row="2"
            Command="{Binding ClosePopupCommand}"
            HorizontalOptions="Center"
            IsEnabled="{Binding CanClose}"
            Text="OK"
            WidthRequest="100" />
    </Grid>
</toolkit:Popup>
