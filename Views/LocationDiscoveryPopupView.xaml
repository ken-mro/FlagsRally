<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="FlagsRally.Views.LocationDiscoveryPopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:converters="clr-namespace:FlagsRally.Converters"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:LocationDiscoveryPopupViewModel"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Margin="0,1,0,0"
    HorizontalOptions="Fill"
    VerticalOptions="Center">
    <toolkit:Popup.Resources>
        <converters:FontFamilyConverter x:Key="FontFamilyConverter" />
    </toolkit:Popup.Resources>
    <Grid
        Padding="20"
        BackgroundColor="Transparent"
        RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <controls:StampLabel
                FontAutoScalingEnabled="True"
                FontSize="Title"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Style="{StaticResource StampHeading}"
                Text="{Binding Heading}" />
            <!--  The place: smaller to stay on one line, or two even lines broken between words. It fills
                  the width, so the popup's size does not follow the name it is fitting.  -->
            <controls:StampNameLabel
                CharacterSpacing="1"
                FontFamily="{Binding LocationName, Converter={StaticResource FontFamilyConverter}}"
                FontSize="24"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                MinFontSize="20"
                Name="{Binding LocationName}"
                TextColor="{StaticResource Navy}"
                TwoLineMinFontSize="20" />
        </VerticalStackLayout>

        <Image
            Grid.Row="1"
            IsVisible="{Binding IsSupportedAdminArea}"
            Aspect="AspectFit"
            HeightRequest="80"
            Source="{Binding ImageSource}"/>
        <Label
            Grid.Row="1"
            IsVisible="{Binding IsCountry}"
            HorizontalOptions="Center"
            FontSize="80"
            Text="{Binding ImageSource}"/>

        <!--  Show celebration animation only for first time country visits  -->
        <skia:SKLottieView
            Grid.Row="0"
            Grid.RowSpan="2"
            HeightRequest="120"
            HorizontalOptions="Fill"
            RepeatMode="Restart"
            Source="celebration.json"
            VerticalOptions="Center" />

        <Button
            Grid.Row="2"
            Command="{Binding ClosePopupCommand}"
            HorizontalOptions="Center"
            Text="OK"
            WidthRequest="100" />
    </Grid>
</toolkit:Popup>