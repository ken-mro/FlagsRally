<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.FlagsBoardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:converters="clr-namespace:FlagsRally.Converters"
    xmlns:map="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:FlagsBoardPageViewModel"
    Style="{StaticResource PaperPage}">
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{Binding FilteredCountry.CountryName}" />
    </Shell.TitleView>
    <ContentPage.Resources>
        <converters:BoardFontSizeConverter x:Key="FontSizeConverter" />
    </ContentPage.Resources>
    <Grid Padding="5" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Progress, map and display options  -->
        <Grid
            Grid.Row="0"
            Padding="6,6,6,0"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="{Binding ProgressText}" />
                <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Stamp}" />
            </VerticalStackLayout>
            <Image
                Grid.Column="1"
                Margin="5,0"
                HeightRequest="25"
                Source="earth.png"
                VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeMapVisibilityCommand}" />
                </Image.GestureRecognizers>
            </Image>
            <Image
                Grid.Column="2"
                Margin="5,0"
                HeightRequest="25"
                SemanticProperties.Description="{x:Static strings:AppResources.HideDateAndMonth}"
                Source="filter.png"
                VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeSettingsVisibilityCommand}" />
                </Image.GestureRecognizers>
            </Image>
        </Grid>

        <!--  All / Visited / Not visited, and display options  -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="6,0"
            Spacing="6">
            <controls:VisitFilterBar />
            <Grid IsVisible="{Binding IsSettingsVisible}">
                <Label
                    Padding="5,0"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="{x:Static strings:AppResources.HideDateAndMonth}"
                    VerticalOptions="Center" />
                <Switch
                    Margin="20,5"
                    HorizontalOptions="End"
                    IsToggled="{Binding DateIsNotVisible}"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCountriesCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView
                x:Name="collectionView"
                Background="Transparent"
                ItemsSource="{Binding DisplayFullSubRegionList}"
                VerticalOptions="Fill">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{Binding GridItemSpan}" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:SubRegion}">
                        <Border
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource Ink}"
                            StrokeShape="RoundRectangle 20,20,20,20"
                            StrokeThickness="4">
                            <StackLayout>
                                <Label
                                    Padding="2"
                                    FontFamily="KiwiMaru-Medium"
                                    FontSize="{Binding Name, Converter={StaticResource FontSizeConverter}}"
                                    HeightRequest="134.48"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding HasNotBeenVisited}"
                                    LineBreakMode="MiddleTruncation"
                                    LineHeight="1"
                                    MaxLines="2"
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource InkMuted}"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout
                                    IsVisible="{Binding HasBeenVisited}"
                                    Spacing="{OnPlatform MacCatalyst=2,
                                                         iOS=2,
                                                         Default=0}"
                                    VerticalOptions="Center">
                                    <Image
                                        Margin="5"
                                        HeightRequest="40"
                                        HorizontalOptions="Center"
                                        Source="{Binding FlagSource}"
                                        VerticalOptions="Center" />
                                    <StackLayout BackgroundColor="{StaticResource Ink}">
                                        <Label
                                            FontFamily="KiwiMaru-Medium"
                                            FontSize="{Binding Name, Converter={StaticResource FontSizeConverter}}"
                                            HorizontalOptions="Center"
                                            LineBreakMode="MiddleTruncation"
                                            LineHeight="1"
                                            MaxLines="2"
                                            Text="{Binding Name}"
                                            TextColor="{StaticResource PaperCard}"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="Medium"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FlagsBoardPageViewModel}}, Path=DateIsVisible}"
                                        LineBreakMode="TailTruncation"
                                        LineHeight="1"
                                        Text="{Binding ArrivalDateString}"
                                        TextColor="{StaticResource Stamp}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="Medium"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FlagsBoardPageViewModel}}, x:DataType=viewmodels:FlagsBoardPageViewModel, Path=DateIsNotVisible}"
                                        LineBreakMode="TailTruncation"
                                        LineHeight="1"
                                        Text="{Binding ArrivalDate, StringFormat='DD  Mmm  {0:yyyy}'}"
                                        TextColor="{StaticResource Stamp}"
                                        VerticalOptions="Center" />
                                    <Line
                                        HorizontalOptions="Center"
                                        Stroke="{StaticResource Ink}"
                                        StrokeThickness="2"
                                        X1="0"
                                        X2="120"
                                        Y1="0"
                                        Y2="0" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontAutoScalingEnabled="True"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="35"
                                        HorizontalOptions="Center"
                                        LineBreakMode="NoWrap"
                                        Text="ARRIVAL"
                                        TextColor="{StaticResource Ink}"
                                        VerticalOptions="Center" />
                                </VerticalStackLayout>
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <map:SfMaps
            Grid.Row="3"
            BackgroundColor="{StaticResource MapSea}"
            IsVisible="{Binding IsMapVisible}">
            <map:SfMaps.Layer>
                <map:MapShapeLayer
                    x:Name="shapeLayer"
                    DataSource="{Binding SourceArrivalSubRegionList}"
                    EnableSelection="True"
                    PrimaryValuePath="IsoCode"
                    ShapeColorValuePath="HasBeenVisited"
                    ShapeDataField="code"
                    ShapeFill="{StaticResource MapLand}"
                    ShapeStroke="{StaticResource PaperCard}"
                    ShapeStrokeThickness="1"
                    ShapesSource="{Binding ShapesSource}"
                    ShowShapeTooltip="True">
                    <map:MapShapeLayer.ColorMappings>
                        <map:EqualColorMapping Color="{StaticResource Stamp}" Value="True" />
                    </map:MapShapeLayer.ColorMappings>
                    <map:MapShapeLayer.ShapeTooltipTemplate>
                        <DataTemplate x:DataType="map:MapTooltipInfo">
                            <VerticalStackLayout>
                                <Image
                                    HeightRequest="20"
                                    Source="{Binding DataItem.MapToolTipImageSource}"
                                    WidthRequest="20" />
                                <Label Text="{Binding DataItem.Name}" TextColor="White" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </map:MapShapeLayer.ShapeTooltipTemplate>
                    <map:MapShapeLayer.ZoomPanBehavior>
                        <map:MapZoomPanBehavior ZoomLevel="1" />
                    </map:MapShapeLayer.ZoomPanBehavior>
                </map:MapShapeLayer>
            </map:SfMaps.Layer>
        </map:SfMaps>
        <ActivityIndicator
            Grid.Row="2"
            Grid.ColumnSpan="2"
            HeightRequest="50"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Navy}" />
    </Grid>
</ContentPage>