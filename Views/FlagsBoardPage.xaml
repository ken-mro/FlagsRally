<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlagsRally.Views.FlagsBoardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:converters="clr-namespace:FlagsRally.Converters"
    xmlns:map="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
    xmlns:models="clr-namespace:FlagsRally.Models"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:FlagsBoardPageViewModel"
    Style="{StaticResource PaperPage}">
    <Shell.TitleView>
        <controls:StampLabel Style="{StaticResource StampTitle}" Text="{Binding FilteredCountry.CountryName}" />
    </Shell.TitleView>
    <ContentPage.Resources>
        <converters:BoardFontSizeConverter x:Key="FontSizeConverter" />
    </ContentPage.Resources>
    <Grid Padding="5" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Progress  -->
        <Grid
            Grid.Row="0"
            Padding="6,6,6,0">
            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="{Binding ProgressText}" />
                <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Stamp}" />
            </VerticalStackLayout>
        </Grid>

        <RefreshView
            Grid.Row="1"
            IsVisible="{Binding IsListVisible}"
            Command="{Binding RefreshCountriesCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView
                x:Name="collectionView"
                Background="Transparent"
                ItemsSource="{Binding DisplayFullSubRegionList}"
                VerticalOptions="Fill">
                <!--  Room for the floating toolbar so the last tiles can scroll above it  -->
                <CollectionView.Footer>
                    <BoxView HeightRequest="84" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{Binding GridItemSpan}" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:SubRegion}">
                        <Border
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource Ink}"
                            StrokeShape="RoundRectangle 20,20,20,20"
                            StrokeThickness="4">
                            <StackLayout>
                                <Label
                                    Padding="2"
                                    FontFamily="KiwiMaru-Medium"
                                    FontSize="{Binding Name, Converter={StaticResource FontSizeConverter}}"
                                    HeightRequest="134.48"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding HasNotBeenVisited}"
                                    LineBreakMode="MiddleTruncation"
                                    LineHeight="1"
                                    MaxLines="2"
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource InkMuted}"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout
                                    IsVisible="{Binding HasBeenVisited}"
                                    Spacing="{OnPlatform MacCatalyst=2,
                                                         iOS=2,
                                                         Default=0}"
                                    VerticalOptions="Center">
                                    <Image
                                        Margin="5"
                                        HeightRequest="40"
                                        HorizontalOptions="Center"
                                        Source="{Binding FlagSource}"
                                        VerticalOptions="Center" />
                                    <StackLayout BackgroundColor="{StaticResource Ink}">
                                        <Label
                                            FontFamily="KiwiMaru-Medium"
                                            FontSize="{Binding Name, Converter={StaticResource FontSizeConverter}}"
                                            HorizontalOptions="Center"
                                            LineBreakMode="MiddleTruncation"
                                            LineHeight="1"
                                            MaxLines="2"
                                            Text="{Binding Name}"
                                            TextColor="{StaticResource PaperCard}"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="Medium"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FlagsBoardPageViewModel}}, Path=DateIsVisible}"
                                        LineBreakMode="TailTruncation"
                                        LineHeight="1"
                                        Text="{Binding ArrivalDateString}"
                                        TextColor="{StaticResource Stamp}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="Medium"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FlagsBoardPageViewModel}}, x:DataType=viewmodels:FlagsBoardPageViewModel, Path=DateIsNotVisible}"
                                        LineBreakMode="TailTruncation"
                                        LineHeight="1"
                                        Text="{Binding ArrivalDate, StringFormat='DD  Mmm  {0:yyyy}'}"
                                        TextColor="{StaticResource Stamp}"
                                        VerticalOptions="Center" />
                                    <Line
                                        HorizontalOptions="Center"
                                        Stroke="{StaticResource Ink}"
                                        StrokeThickness="2"
                                        X1="0"
                                        X2="120"
                                        Y1="0"
                                        Y2="0" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontAutoScalingEnabled="True"
                                        FontFamily="JerseyclubGrungeBold"
                                        FontSize="35"
                                        HorizontalOptions="Center"
                                        LineBreakMode="NoWrap"
                                        Text="ARRIVAL"
                                        TextColor="{StaticResource Ink}"
                                        VerticalOptions="Center" />
                                </VerticalStackLayout>
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <!--  The regions on a map, in place of the tiles  -->
        <map:SfMaps
            Grid.Row="1"
            BackgroundColor="{StaticResource MapSea}"
            IsVisible="{Binding IsMapVisible}">
            <map:SfMaps.Layer>
                <map:MapShapeLayer
                    x:Name="shapeLayer"
                    DataSource="{Binding SourceArrivalSubRegionList}"
                    EnableSelection="True"
                    PrimaryValuePath="IsoCode"
                    ShapeColorValuePath="HasBeenVisited"
                    ShapeDataField="code"
                    ShapeFill="{StaticResource MapLand}"
                    ShapeStroke="{StaticResource PaperCard}"
                    ShapeStrokeThickness="1"
                    ShapesSource="{Binding ShapesSource}"
                    ShowShapeTooltip="True">
                    <map:MapShapeLayer.ColorMappings>
                        <map:EqualColorMapping Color="{StaticResource Stamp}" Value="True" />
                    </map:MapShapeLayer.ColorMappings>
                    <map:MapShapeLayer.ShapeTooltipTemplate>
                        <DataTemplate x:DataType="map:MapTooltipInfo">
                            <VerticalStackLayout>
                                <Image
                                    HeightRequest="20"
                                    Source="{Binding DataItem.MapToolTipImageSource}"
                                    WidthRequest="20" />
                                <Label Text="{Binding DataItem.Name}" TextColor="White" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </map:MapShapeLayer.ShapeTooltipTemplate>
                    <map:MapShapeLayer.ZoomPanBehavior>
                        <map:MapZoomPanBehavior ZoomLevel="1" />
                    </map:MapShapeLayer.ZoomPanBehavior>
                </map:MapShapeLayer>
            </map:SfMaps.Layer>
        </map:SfMaps>
        <ActivityIndicator
            Grid.Row="1"
            Grid.ColumnSpan="2"
            HeightRequest="50"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Navy}" />
        <!--  Controls float just above the tab bar, within thumb reach, over the tiles  -->
        <Border
            Grid.RowSpan="2"
            Margin="7,0,7,7"
            Padding="8"
            BackgroundColor="{StaticResource PaperCard}"
            Stroke="{StaticResource PaperEdge}"
            StrokeShape="RoundRectangle 30"
            StrokeThickness="1"
            VerticalOptions="End">
            <Border.Shadow>
                <Shadow
                    Brush="{StaticResource NavyDeep}"
                    Opacity="0.18"
                    Radius="14"
                    Offset="0,4" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <controls:VisitFilterBar />
                <ImageButton
                    Grid.Column="1"
                    Padding="11"
                    BackgroundColor="Transparent"
                    Command="{Binding ChooseDisplayOptionsCommand}"
                    HeightRequest="44"
                    SemanticProperties.Description="{x:Static strings:AppResources.DisplayOptions}"
                    Source="filter.png"
                    WidthRequest="44" />
                <Border
                    Grid.Column="2"
                    BackgroundColor="{StaticResource Navy}"
                    HeightRequest="44"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangeMapVisibilityCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image
                            HeightRequest="22"
                            IsVisible="{Binding IsListVisible}"
                            SemanticProperties.Description="{x:Static strings:AppResources.ShowMap}"
                            Source="earth.png">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource PaperCard}" />
                            </Image.Behaviors>
                        </Image>
                        <Image
                            HeightRequest="22"
                            IsVisible="{Binding IsMapVisible}"
                            SemanticProperties.Description="{x:Static strings:AppResources.ShowStamps}"
                            Source="board.png">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource PaperCard}" />
                            </Image.Behaviors>
                        </Image>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>