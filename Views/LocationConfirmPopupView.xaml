<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="FlagsRally.Views.LocationConfirmPopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlagsRally.Controls"
    xmlns:strings="clr-namespace:FlagsRally.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:LocationConfirmPopupViewModel"
    BackgroundColor="{StaticResource PaperCard}"
    CanBeDismissedByTappingOutsideOfPopup="True"
    HorizontalOptions="Fill"
    Padding="0"
    VerticalOptions="Center">
    <!--  The place found for a stamp, laid out as a passport stamp's details (ArrivalInfoPopupView)  -->
    <Grid
        Padding="20,10,20,4"
        RowDefinitions="Auto,Auto,Auto,Auto"
        RowSpacing="14">
        <!--  The heading, with ✕ (No) as on the map's cards  -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <controls:StampLabel
                LineBreakMode="WordWrap"
                Style="{StaticResource StampHeading}"
                Text="{x:Static strings:AppResources.Confirmation}"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Margin="0,0,-12,0"
                Command="{Binding NoCommand}"
                HeightRequest="44"
                SemanticProperties.Description="{x:Static strings:AppResources.Close}"
                Style="{StaticResource CloseGlyphButton}"
                VerticalOptions="Start" />
        </Grid>
        <Label
            Grid.Row="1"
            FontSize="15"
            LineBreakMode="WordWrap"
            Text="{Binding Message}"
            TextColor="{StaticResource Ink}" />
        <controls:LocationDetailsView Grid.Row="2" />
        <!--  Yes filled, No as quiet text under it: full width, so long labels wrap instead of squeezing  -->
        <VerticalStackLayout Grid.Row="3" Spacing="2">
            <Button
                Command="{Binding YesCommand}"
                CornerRadius="10"
                LineBreakMode="WordWrap"
                Text="{x:Static strings:AppResources.Yes}" />
            <Button
                Command="{Binding NoCommand}"
                LineBreakMode="WordWrap"
                Style="{StaticResource TextButton}"
                Text="{x:Static strings:AppResources.No}" />
        </VerticalStackLayout>
    </Grid>
</toolkit:Popup>
