<?xml version="1.0" encoding="utf-8" ?>
<!--  How far through a board: "3 / 47" above a progress bar, at the top of the two board pages  -->
<ContentView
    x:Class="FlagsRally.Controls.BoardProgressHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:FlagsRally.ViewModels"
    x:DataType="viewmodels:BoardViewModelBase">
    <Grid Padding="6,6,6,0">
        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
            <Label
                FontAttributes="Bold"
                FontSize="22"
                Text="{Binding ProgressText}" />
            <ProgressBar Progress="{Binding Progress}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
